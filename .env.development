# Local dev: Vite proxies /api and /health → Media Bridge (see vite.config.ts).
# Run in a second terminal: npm run dev:api  (port 8787)
VITE_STREAM_API_USE_VITE_PROXY=true
# Leave VITE_STREAM_API_BASE unset (or use vite-proxy) so fetches stay same-origin.

# --- Email (optional for local; required for pairing-reminder / welcome without session) ---
# Put the real values in .env.local (gitignored). Must match MEDIA_BRIDGE_WELCOME_KEY on the bridge.
# VITE_MEDIA_BRIDGE_WELCOME_KEY=
# VITE_YOUTUBE_API_KEY=
