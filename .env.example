VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
# Optional parent PIN overrides (leave unset in production — use profiles.parent_pin / hashed PIN)
# VITE_PARENT_MANAGEMENT_PIN=
# VITE_PARENT_UNLOCK_PIN=

# Forgot parent PIN emails: require logged-in Bearer session (do not ship welcome keys in VITE_*).

# =============================================================================
# Web / PWA deploy (Vercel or Netlify) — iPhone testers via Safari link
# =============================================================================
# Android/Capacitor APK is separate; for browser/PWA testing only set these on the host:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_YOUTUBE_API_KEY (optional if search goes via bridge)
#   VITE_STREAM_API_BASE=https://safetube-media-bridge.onrender.com
#   VITE_CLIENT_STREAM_RESOLVE=true
# Also allow the Vercel/Netlify origin in Supabase Auth → Redirect URLs
# and on the Media Bridge CORS_ORIGIN env.
#
# Install as PWA on iPhone: Safari → Share → Add to Home Screen

# =============================================================================
# Media Bridge — LOCAL DEVELOPMENT (.env or .env.local)
# =============================================================================
# Search/stream use GET /api/youtube/search, /api/stream/:id, etc.
# Recommended: Vite dev server proxies /api → http://127.0.0.1:8787 (see vite.config.ts).
# Start bridge in a second terminal: npm run dev:api
#
# Option A (recommended) — explicit Vite proxy, no frontend URL in BASE:
# VITE_STREAM_API_USE_VITE_PROXY=true
# (do not set VITE_STREAM_API_BASE, or set VITE_STREAM_API_BASE=vite-proxy)
#
# Option B — direct to bridge (no Vite proxy; CORS must allow your Vite port):
# VITE_STREAM_API_BASE=http://127.0.0.1:8787
#
# WRONG for local dev (returns HTML 404 on search):
# VITE_STREAM_API_BASE=https://your-app.vercel.app
# VITE_STREAM_API_BASE=https://safetube-media-bridge.onrender.com  (use only if testing remote bridge)
#
# Optional: change proxy target if bridge is not on 8787
# VITE_MEDIA_BRIDGE_PROXY_TARGET=http://127.0.0.1:8787

# =============================================================================
# Media Bridge — PRODUCTION (.env.production or Vercel env)
# =============================================================================
# Set ONLY the bridge origin (HTTPS), never the Vercel/frontend URL:
# VITE_STREAM_API_BASE=https://safetube-media-bridge.onrender.com
# or your Cloudflare tunnel, e.g.:
# VITE_STREAM_API_BASE=https://YOUR_TUNNEL.trycloudflare.com
# Do NOT set VITE_STREAM_API_USE_VITE_PROXY in production.
# Browser asks the bridge to resolve streams (recommended for web/PWA testers):
# VITE_CLIENT_STREAM_RESOLVE=true

# Rare: use official YouTube iframe (youtube-nocookie) with modestbranding=1&rel=0 instead of Media Bridge.
# Leave unset/false in production for kids mode (proxied stream has no YouTube UI).
# VITE_YOUTUBE_IFRAME_PLAYER=true

# Redirect target after signup email confirmation.
# Example (local dev): http://localhost:5174/auth?emailVerified=1
# VITE_AUTH_SIGNUP_REDIRECT_TO=

# Optional OAuth callback override (Google, etc). If unset, defaults to:
# ${window.location.origin}/auth?next=/dashboard
# Example (production): https://kids-safe-tube.vercel.app/auth?next=%2Fdashboard
# VITE_AUTH_OAUTH_REDIRECT_TO=
#
# Google sign-in ב-Supabase: Dashboard → Authentication → Providers → הפעילו Google והזינו Client ID/Secret.
# בחלון URL Configuration יש להוסיף לאותיות את כתובת החזרה (Redirect URLs), למשל:
# http://localhost:5174/auth  ואת דומיין ה-production + /auth

# Temporary: show "דילוג על אימות" in forgot parent PIN modal (OAuth path). Remove after resetting PIN.
# VITE_PARENT_PIN_FORGOT_SKIP_VERIFY=1

# Dev-only fallback. Do not set this in production.
# VITE_DEV_DEVICE_OWNER_ID=00000000-0000-0000-0000-000000000000

# =============================================================================
# Tester access gate (Firebase Remote Config) — used by Android APK builds
# =============================================================================
# Create a Firebase Web App, then set these in .env.production before `npm run android:apk`.
# Remote Config keys (Firebase Console → Remote Config):
#   tester_access_enabled  = true|false   (false locks all testers immediately)
#   tester_access_code     = shared QA code
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Optional in-app default until the first Remote Config fetch succeeds:
# VITE_TESTER_ACCESS_CODE_DEFAULT=SafeTubeQA
# Force gate on web (1) or disable even on native APK (0):
# VITE_TESTER_GATE=1
