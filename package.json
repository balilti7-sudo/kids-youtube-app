{
  "name": "safetube",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/run-bridge-dev.mjs",
    "dev:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-dev.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "postinstall": "node scripts/patch-capacitor-webview.mjs",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.47.10",
    "@videojs/http-streaming": "^3.17.4",
    "bgutils-js": "3.2.0",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.28.0",
    "resend": "^6.12.2",
    "sonner": "^1.7.1",
    "video.js": "^8.23.7",
    "youtubei.js": "^17.2.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.16",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
